# Dump Bot — настройки. Скопируйте в .env и заполните:  cp .env.example .env
# Формат: КЛЮЧ=значение, без кавычек и пробелов вокруг «=». Комментарии — только отдельной строкой.
# Значения по умолчанию совпадают с src/dumpbot/config.py. .env не коммитить (он в .gitignore).

# ───────────── Telegram ─────────────
# Токен бота от @BotFather.
BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Ваш Telegram ID. 0 = ещё не настроен: бот ответит на /start вашим ID — впишите его сюда
# и перезапустите бота (docker compose up -d). Сообщения от всех остальных бот игнорирует.
OWNER_ID=0

# ───────────── База данных ─────────────
# Пароль Postgres (контейнер db и строка подключения). Только латинские буквы и цифры:
# он подставляется в URL, символы вроде @ : / % # $ его ломают.
POSTGRES_PASSWORD=ChangeMe123
# Порт Postgres на хосте (слушает только 127.0.0.1) — для DBeaver и запуска бота без Docker.
DB_HOST_PORT=5432
# Строка подключения для запуска на хосте (uv run alembic ..., uv run python -m dumpbot).
# Внутри Docker Compose её заменяет адрес контейнера db, поэтому один .env подходит для обоих случаев.
# Пароль должен совпадать с POSTGRES_PASSWORD, порт — с DB_HOST_PORT.
DATABASE_URL=postgresql+asyncpg://dump:ChangeMe123@127.0.0.1:5432/dump

# ───────────── chutes.ai (ИИ) ─────────────
# API-ключ chutes.ai (начинается с cpk_). Нужен положительный баланс (оплата по факту).
CHUTES_API_KEY=cpk_replace_me
# OpenAI-совместимый API.
CHUTES_BASE_URL=https://llm.chutes.ai/v1
# Основная модель: текст + картинки, structured outputs.
LLM_MODEL=google/gemma-4-31B-turbo-TEE
# Запасная модель для текста (основная недоступна или вернула негодный ответ).
LLM_FALLBACK_MODEL=Qwen/Qwen3-32B-TEE
# Запасная модель для сообщений с картинками.
VISION_FALLBACK_MODEL=Qwen/Qwen3.6-27B-TEE
# Таймаут одного запроса к модели, секунды.
LLM_TIMEOUT_S=60
# Максимум токенов в ответе модели.
LLM_MAX_TOKENS=1500
# Цена за 1M токенов (вход / выход, USD), если прайс-лист chutes недоступен. Завышена: бюджет считается с запасом.
LLM_FALLBACK_PRICE_IN=1.0
LLM_FALLBACK_PRICE_OUT=3.0

# ───────────── Распознавание голосовых ─────────────
# Whisper на chutes (community-chute AudioDojo).
STT_URL=https://vonkaiser-audiodojo.chutes.ai/stt/whisper
# Таймаут распознавания, секунды.
STT_TIMEOUT_S=60
# Голосовые и аудио длиннее этого (секунды) не распознаются: сохраняются как «Аудио: файл» (или по подписи).
STT_MAX_DURATION_S=300
# true — перед отправкой перекодировать OGG/Opus в WAV 16 кГц моно через ffmpeg
# (включите, если голосовые не распознаются).
STT_CONVERT_WAV=false
# Оценка стоимости секунды распознавания, USD (для учёта бюджета).
STT_USD_PER_SECOND=0.0005

# ───────────── Локальный Whisper (необязательно) ─────────────
# Бесплатное распознавание голосовых на этом компьютере: контейнер whisper (профиль compose «whisper»).
# Включение: впишите LOCAL_STT_URL=http://whisper:9000 и выполните docker compose --profile whisper up -d --build
# (подробно — README, раздел «Локальный Whisper»). Пусто — выключен.
# Порядок (авто / локальный / только chutes) выбирается в боте: /settings → 🎙 Голос.
LOCAL_STT_URL=
# Таймаут локального распознавания, секунды (на CPU; первый запрос ещё и скачивает/загружает модель).
LOCAL_STT_TIMEOUT_S=120
# Модель: tiny, base, small, medium. Больше — точнее, но медленнее и требует больше памяти.
WHISPER_MODEL=small
# Потоков CPU для распознавания; 0 — все ядра, доступные Docker.
WHISPER_THREADS=0
# Beam size: 1 — быстрее всего; 5 — немного точнее, но в несколько раз медленнее.
WHISPER_BEAM_SIZE=1
# Аудио длиннее этого (секунды) локальный сервис не берёт (ответ 413) — бот отдаёт его в chutes.
WHISPER_MAX_AUDIO_S=120
# Лимит памяти контейнера whisper: small работает примерно в 1 ГБ; для medium поставьте 4g.
WHISPER_MEM_LIMIT=2g

# ───────────── Telegram Mini App (необязательно) ─────────────
# Приложение «📱 Свалка» внутри Telegram: лента, задачи, карточки, настройки. Наружу его публикует Tailscale Funnel
# (контейнер tailscale, профиль compose «miniapp»), подробно — README, раздел «Mini App».
# true — бот запускает свой веб-сервер (API + собранный фронтенд) на WEBAPP_HOST:WEBAPP_PORT внутри сети Docker.
WEBAPP_ENABLED=false
# Адрес и порт веб-сервера бота. Tailscale проксирует на http://bot:8080 (tailscale/serve.json) — меняйте вместе.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Публичный HTTPS-адрес приложения для кнопки меню, например https://dump.tail1234.ts.net
# (имя tailnet — в админке Tailscale, раздел DNS). Пусто — кнопка меню остаётся списком команд.
WEBAPP_URL=
# Папка с собранным фронтендом (index.html и assets/). В Docker-образе — /app/webapp.
WEBAPP_STATIC_DIR=/app/webapp
# Ключ авторизации Tailscale (Admin console → Settings → Keys → Generate auth key). Нужен только при первом
# запуске контейнера tailscale: дальше он помнит себя в томе tailscale-state.
TS_AUTHKEY=

# ───────────── Начальные настройки ─────────────
# Используются только при первом запуске; дальше всё меняется в боте через /settings.
# Часовой пояс (IANA).
DEFAULT_TZ=Europe/Warsaw
# Месячный бюджет на ИИ, USD: 80% — предупреждение, 100% — ИИ выключается до конца месяца.
DEFAULT_BUDGET_USD=5.0

# ───────────── Служебное ─────────────
# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Файл-«пульс» планировщика для healthcheck. В Docker всегда /tmp/heartbeat (задано в compose.yaml);
# для запуска на Windows без Docker укажите путь в существующей папке, например C:/Temp/dumpbot-heartbeat.
HEARTBEAT_FILE=/tmp/heartbeat
# Как часто планировщик проверяет напоминания и дайджесты, секунды.
SCHEDULER_INTERVAL_S=30
