# Only pyproject.toml, uv.lock, README.md, src/, alembic.ini, migrations/ and webapp/ (the Mini App sources, built in
# the image) are needed in the build context.

# Secrets
.env
*.env
.env.*

# Python / tooling
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Mini App: dependencies and builds are made inside the image
webapp/node_modules/
webapp/dist/
webapp/coverage/
**/node_modules/

# Not part of the image
.git/
.gitignore
.gitattributes
.claude/
.idea/
.vscode/
tests/
docs/
whisper/
tailscale/
backups/
*.backup
*.dump
Dockerfile
compose.yaml
.dockerignore
